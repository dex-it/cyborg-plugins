{
  "$schema": "../../../node_modules/@cyborg-harness/contracts/manifest.schema.json",
  "id": "sessions",
  "version": "1.0.0",
  "engines": { "cyborg": "^1" },
  "provides": { "cyborg.sessions": "1.2" },
  "requires": { "cyborg.projects": "^1" },
  "consumes": { "cyborg.agent": "^1", "cyborg.session-prompt": "^1", "cyborg.agent-tool": "^1" },
  "commands": {
    "sessions.agents": {},
    "sessions.create": { "args": ["record"] },
    "sessions.resume": { "args": ["record"] },
    "sessions.kill": { "args": ["string"] },
    "sessions.write": { "args": ["string", "string"] },
    "sessions.resize": { "args": ["string", "number", "number"] },
    "sessions.previous": {},
    "sessions.running": {},
    "sessions.reopen": { "args": ["string"] },
    "sessions.restore": { "args": ["string"] },
    "sessions.tabs": {},
    "sessions.close-tab": { "args": ["string"] },
    "sessions.new-request": {},
    "sessions.font-reset": {},
    "sessions.open-path": { "args": ["string"] },
    "sessions.open-url": { "args": ["string"] },
    "sessions.copy": { "args": ["string"] },
    "sessions.paste-text": {},
    "sessions.history.list": { "args": ["string"] },
    "sessions.history.delete": { "args": ["string", "string", "array", "string"] }
  },
  "keybindings": [
    { "key": "CmdOrCtrl+Shift+N", "command": "sessions.new-request" },
    { "key": "CmdOrCtrl+0", "command": "sessions.font-reset" }
  ],
  "documents": { "session": { "restorable": true, "area": "main", "order": 100 } },
  "permissions": {
    "fs.read": ["workspace"],
    "fs.write": ["workspace"],
    "shell": ["any", "http:", "https:"],
    "clipboard": ["read", "write"],
    "pty": [
      {
        "program": "$SHELL",
        "args": ["-lc", "exec claude --settings \"$CYBORG_SETTINGS\" \"$@\"", "cyborg"],
        "env": ["CYBORG_EVENTS", "CYBORG_SETTINGS", "CYBORG_MCP_TOKEN"],
        "deny": ["--dangerously-skip-permissions", "--permission-mode", "--allowedTools", "--allowed-tools", "--disallowedTools", "--tools"]
      },
      {
        "program": "ssh",
        "args": ["-tt", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3", "-o", "ExitOnForwardFailure=yes", "--"],
        "env": ["SSH_AUTH_SOCK"]
      }
    ]
  },
  "ui": {
    "views": {
      "main": { "module": "./ui/main.js", "area": "main", "order": 100 },
      "history": { "module": "./ui/history.js", "area": "sidebar", "order": 200, "title": "Сессии проекта" }
    },
    "inlineStyles": true
  }
}
