{
  "name": "cyborg-plugins-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сайт документации Cyborg Plugins (Starlight)",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "brand": "node scripts/copy-brand.mjs",
    "dev": "npm run brand && npm run catalog && astro dev",
    "build": "npm run brand && npm run catalog && astro build",
    "verify": "node scripts/check-dist.mjs",
    "preview": "astro preview",
    "check": "npm run brand && npm run catalog && astro check",
    "astro": "astro",
    "catalog": "node ../scripts/gen-catalog.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.9",
    "@astrojs/starlight": "0.42.11",
    "astro": "7.4.11",
    "mermaid": "12.3.0",
    "satteri": "0.11.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3"
  }
}
